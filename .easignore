# EAS Build ignore file
# Files and directories to exclude from EAS builds

# Docker and socket files
.docker/
**/.docker/
*.sock
**/*.sock
mutagen/
**/mutagen/

# Build artifacts
*.ipa
*.app
*.aab
*.apk

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Other projects (exclude from parent)
EquiLedger/
event*/
*Platform*/
