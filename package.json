{
  "name": "spect-it-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Spect-IT - Advanced Professional Eye Testing Platform Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "web:dev": "turbo run dev --filter=web",
    "web:build": "turbo run build --filter=web",
    "mobile:dev": "turbo run dev --filter=mobile",
    "mobile:build": "turbo run build --filter=mobile"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@9.0.0"
}
